# Local development defaults. Copy to .env; never commit the copied file.
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Production only: set FLASK_ENV=production and provide a generated secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=

# Configure one model credential. Never commit real values.
# OPENAI_API_KEY=
# Or use a GitHub Models token:
# GITHUB_TOKEN=

# Optional model configuration:
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini
