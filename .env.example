# Local development defaults. Copy to .env; never commit the copied file.
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Production only: set FLASK_ENV=production and provide a generated secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=

# Recommended: create a key in Google AI Studio. Never commit real values.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Alternative: any OpenAI-compatible chat-completions provider.
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini
