{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PM Mentor (development)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "envFile": "${workspaceFolder}\\.env",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development"
      },
      "args": [
        "run",
        "--no-debugger",
        "--host",
        "127.0.0.1",
        "--port",
        "5000"
      ],
      "jinja": true
    }
  ]
}
