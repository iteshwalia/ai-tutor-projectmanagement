{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create virtual environment",
      "type": "shell",
      "command": "py -m venv .venv",
      "problemMatcher": []
    },
    {
      "label": "Install development dependencies",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements-dev.txt"],
      "dependsOn": "Create virtual environment",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint Python",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "ruff", "check", "."],
      "problemMatcher": []
    }
  ]
}
